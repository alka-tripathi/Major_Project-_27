# ==============================================================================
# BrainTumorAI Root .gitignore
# ==============================================================================

# Node / JavaScript Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Frontend Build Outputs
.next/
**/.next/
out/
build/
dist/
*.tsbuildinfo

# Sensitive Environment & Secret Configs
.env
.env.local
.env.development
.env.production
.env*.local
*.env

# Testing & Coverage
coverage/
.nyc_output/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Python Cache & Compiled Files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Explicitly ensure Jupyter Notebook files are NEVER ignored
!*.ipynb

# Explicitly ensure segmentation and training folders are 100% fully tracked
!python-backend/segmentation/
!python-backend/segmentation/**
!python-backend/training/
!python-backend/training/**

# Machine Learning Model Weights & Large Binary Files (Hosted on HuggingFace)
*.h5
*.keras
*.weights.h5
*.pth
*.pt
*.onnx
*.pkl
*.joblib
*.pb
*.ckpt

# Local Datasets & Generated Image Outputs
python-backend/dataset/
python-backend/uploads/
python-backend/heatmaps/
python-backend/segmentations/
python-backend/gradcam/gradcam_outputs/
python-backend/gradcam/misclassified_samples/
python-backend/preprocessing/unet_eval_outputs/

# OS & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
.vscode/
.idea/
*.swp
*.swo
